# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bettercallsaul
DB_USER=postgres
DB_PASSWORD=[PASSWORD]

# Embedding Model Configuration
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# LLM Provider Configuration ("ollama" or "transformers")
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Local transformers configuration (if LLM_PROVIDER=transformers)
TRANSFORMERS_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# API Keys (Optional fallbacks for fast, high-quality generation testing)
GEMINI_API_KEY=
OPENAI_API_KEY=
